[
  {
    "id": "sar-cliff",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 13,
    "filter": [
      "all",
      [
        "==",
        "class",
        "hazard"
      ],
      [
        "==",
        "subclass",
        "cliff"
      ]
    ],
    "layout": {
      "line-cap": "butt"
    },
    "paint": {
      "line-color": "#7a5c3d",
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        13,
        1.5,
        16,
        4
      ],
      "line-dasharray": [
        0.5,
        0.5
      ]
    }
  },
  {
    "id": "sar-power-line",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 11,
    "filter": [
      "all",
      [
        "==",
        "class",
        "hazard"
      ],
      [
        "in",
        "subclass",
        "power_line",
        "minor_line"
      ]
    ],
    "paint": {
      "line-color": "#5f5f5f",
      "line-width": [
        "case",
        [
          "==",
          [
            "get",
            "subclass"
          ],
          "power_line"
        ],
        1.2,
        0.6
      ],
      "line-dasharray": [
        6,
        2,
        1,
        2
      ]
    }
  },
  {
    "id": "sar-trail",
    "type": "line",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 12,
    "filter": [
      "==",
      "class",
      "trail"
    ],
    "layout": {
      "line-cap": "round",
      "line-join": "round"
    },
    "paint": {
      "line-color": [
        "match",
        [
          "get",
          "sac_scale"
        ],
        "hiking",
        "#33a02c",
        "mountain_hiking",
        "#1f78b4",
        "demanding_mountain_hiking",
        "#ff7f00",
        "alpine_hiking",
        "#e31a1c",
        "demanding_alpine_hiking",
        "#b10026",
        "difficult_alpine_hiking",
        "#000000",
        [
          "case",
          [
            "has",
            "via_ferrata_scale"
          ],
          "#6a3d9a",
          "#ff7f00"
        ]
      ],
      "line-width": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        12,
        1.5,
        16,
        3.5
      ],
      "line-dasharray": [
        "case",
        [
          "in",
          [
            "get",
            "trail_visibility"
          ],
          [
            "literal",
            [
              "bad",
              "horrible",
              "no"
            ]
          ]
        ],
        [
          "literal",
          [
            1,
            2
          ]
        ],
        [
          "literal",
          [
            3,
            1.5
          ]
        ]
      ]
    }
  },
  {
    "id": "sar-trail-name",
    "type": "symbol",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 14,
    "filter": [
      "all",
      [
        "==",
        "class",
        "trail"
      ],
      [
        "has",
        "name"
      ]
    ],
    "layout": {
      "symbol-placement": "line",
      "text-field": "{name}",
      "text-font": [
        "Noto Sans Regular"
      ],
      "text-size": 11
    },
    "paint": {
      "text-color": "#444",
      "text-halo-color": "rgba(255,255,255,0.8)",
      "text-halo-width": 1.5
    }
  },
  {
    "id": "sar-point",
    "type": "circle",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 10,
    "filter": [
      "==",
      "$type",
      "Point"
    ],
    "paint": {
      "circle-radius": [
        "interpolate",
        [
          "linear"
        ],
        [
          "zoom"
        ],
        10,
        3,
        14,
        6
      ],
      "circle-color": [
        "match",
        [
          "get",
          "class"
        ],
        "shelter",
        "#8a4b08",
        "water",
        "#1f78b4",
        "emergency",
        "#e31a1c",
        "landing",
        "#6a3d9a",
        "hazard",
        "#4d4d4d",
        "#000"
      ],
      "circle-stroke-color": "#ffffff",
      "circle-stroke-width": 1.5
    }
  },
  {
    "id": "sar-point-label",
    "type": "symbol",
    "source": "openmaptiles",
    "source-layer": "sar",
    "minzoom": 12,
    "filter": [
      "all",
      [
        "==",
        "$type",
        "Point"
      ],
      [
        "any",
        [
          "has",
          "name"
        ],
        [
          "has",
          "ref"
        ]
      ]
    ],
    "layout": {
      "text-field": [
        "coalesce",
        [
          "get",
          "name"
        ],
        [
          "get",
          "ref"
        ]
      ],
      "text-font": [
        "Noto Sans Regular"
      ],
      "text-size": 11,
      "text-anchor": "top",
      "text-offset": [
        0,
        0.8
      ],
      "text-max-width": 8,
      "text-optional": true
    },
    "paint": {
      "text-color": [
        "match",
        [
          "get",
          "class"
        ],
        "shelter",
        "#8a4b08",
        "water",
        "#1f78b4",
        "emergency",
        "#e31a1c",
        "landing",
        "#6a3d9a",
        "hazard",
        "#4d4d4d",
        "#000"
      ],
      "text-halo-color": "rgba(255,255,255,0.9)",
      "text-halo-width": 1.5
    }
  }
]
